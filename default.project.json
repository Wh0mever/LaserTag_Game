{
	"name": "LaserTag",
	"tree": {
		"$className": "DataModel",

		"Workspace": {
			"$properties": {
				"FilteringEnabled": true,
				"StreamingEnabled": false
			}
		},

		"Players": {
			"$properties": {
				"CharacterAutoLoads": false,
				"RespawnTime": 3
			}
		},

		"Lighting": {
			"$properties": {
				"Technology": "Future",
				"Ambient": [60, 60, 70],
				"OutdoorAmbient": [110, 110, 125],
				"Brightness": 2,
				"ClockTime": 15,
				"GlobalShadows": true,
				"EnvironmentDiffuseScale": 0.4,
				"EnvironmentSpecularScale": 0.3
			}
		},

		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		},

		"Teams": {
			"$className": "Teams"
		},

		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},

		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},

		"StarterPlayer": {
			"$properties": {
				"CameraMode": "LockFirstPerson",
				"CameraMaxZoomDistance": 0.5,
				"CameraMinZoomDistance": 0.5,
				"EnableMouseLockOption": false
			},

			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			},

			"StarterCharacterScripts": {
				"$className": "StarterCharacterScripts"
			}
		},

		"StarterGui": {
			"$properties": {
				"ShowDevelopmentGui": true
			}
		}
	}
}
